{
  "manifest_version": 3,
  "name": "CapCut Auto Login Helper",
  "version": "1.0.0",
  "description": "Tự động đăng nhập siêu tốc tài khoản CapCut từ danh sách hoặc Web Tool",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.capcut.com/*",
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CapCut Auto Login"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.capcut.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

